rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles
    match /users/{userId} {
      allow read, write: if request.auth != null &&
                         request.auth.uid == userId;
    }

    // Customer bookings
    match /bookings/{bookingId} {

      // A customer can read only their own bookings
      allow read: if request.auth != null &&
                  resource.data.customerId == request.auth.uid;

      // A customer can create only bookings for themselves
      allow create: if request.auth != null &&
                    request.resource.data.customerId == request.auth.uid;

      // A customer can update only their own booking
      allow update: if request.auth != null &&
                    resource.data.customerId == request.auth.uid;

      // Prevent direct deletion from the client
      allow delete: if false;
    }

    // Availability locks (PII-free)
    match /slotLocks/{lockId} {

      // Anyone can read availability
      allow read: if true;

      // Allow authenticated users to create/update/delete slot locks
      // because the current app writes slotLocks directly from the client
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}